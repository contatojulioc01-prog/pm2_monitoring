{
  "name": "pm2-gui-web",
  "version": "2.0.0",
  "description": "DC - PM2 Manager & Gerenciador de Permissões (Doce Brinquedo)",
  "main": "backend/src/server.js",
  "scripts": {
    "start": "node backend/src/server.js",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue.bold,magenta.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && node --watch src/server.js",
    "dev:frontend": "cd frontend && npm start",
    "build": "cd frontend && npm run build"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "knex": "^3.3.0",
    "liquidjs": "^10.30.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "pm2": "^7.1.1",
    "socket.io": "^4.8.4",
    "sqlite3": "^6.0.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "license": "MIT"
}
