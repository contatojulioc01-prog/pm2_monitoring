import { Component, Input, Output, EventEmitter } from '@angular/core';
import { CommonModule } from '@angular/common';
import { MatTableModule } from '@angular/material/table';
import { MatButtonModule } from '@angular/material/button';
import { MatIconModule } from '@angular/material/icon';
import { MatTooltipModule } from '@angular/material/tooltip';
import { MatMenuModule } from '@angular/material/menu';
import { Pm2Process } from '../../services/pm2.service';

@Component({
  selector: 'app-process-list',
  standalone: true,
  imports: [CommonModule, MatTableModule, MatButtonModule, MatIconModule, MatTooltipModule, MatMenuModule],
  template: `
    <div class="table-wrapper">
      <table mat-table [dataSource]="processes" class="proc-table">

        <!-- ID -->
        <ng-container matColumnDef="id">
          <th mat-header-cell *matHeaderCellDef>ID</th>
          <td mat-cell *matCellDef="let p">
            <span class="cell-id">#{{ p.id }}</span>
          </td>
        </ng-container>

        <!-- Name -->
        <ng-container matColumnDef="name">
          <th mat-header-cell *matHeaderCellDef>Nome</th>
          <td mat-cell *matCellDef="let p">
            <span class="cell-name">{{ p.name }}</span>
          </td>
        </ng-container>

        <!-- Status -->
        <ng-container matColumnDef="status">
          <th mat-header-cell *matHeaderCellDef>Status</th>
          <td mat-cell *matCellDef="let p">
            <span class="status-badge" [class]="'badge--' + p.status">
              {{ p.status.toUpperCase() }}
            </span>
          </td>
        </ng-container>

        <!-- CPU -->
        <ng-container matColumnDef="cpu">
          <th mat-header-cell *matHeaderCellDef>CPU</th>
          <td mat-cell *matCellDef="let p">{{ p.cpu }}%</td>
        </ng-container>

        <!-- Memory -->
        <ng-container matColumnDef="memory">
          <th mat-header-cell *matHeaderCellDef>RAM</th>
          <td mat-cell *matCellDef="let p">{{ formatMemory(p.memory) }}</td>
        </ng-container>

        <!-- Restarts -->
        <ng-container matColumnDef="restarts">
          <th mat-header-cell *matHeaderCellDef>Restarts</th>
          <td mat-cell *matCellDef="let p">{{ p.restarts }}</td>
        </ng-container>

        <!-- Uptime -->
        <ng-container matColumnDef="uptime">
          <th mat-header-cell *matHeaderCellDef>Uptime</th>
          <td mat-cell *matCellDef="let p">{{ formatUptime(p.uptime) }}</td>
        </ng-container>

        <!-- Mode -->
        <ng-container matColumnDef="mode">
          <th mat-header-cell *matHeaderCellDef>Modo</th>
          <td mat-cell *matCellDef="let p">{{ p.execMode }}</td>
        </ng-container>

        <!-- Actions -->
        <ng-container matColumnDef="actions">
          <th mat-header-cell *matHeaderCellDef>Ações</th>
          <td mat-cell *matCellDef="let p">
            <div class="row-actions">
              @if (p.status === 'online') {
                <button mat-icon-button (click)="onStop.emit(p)" matTooltip="Parar" class="btn--stop">
                  <mat-icon>stop</mat-icon>
                </button>
              } @else {
                <button mat-icon-button (click)="onStart.emit(p)" matTooltip="Iniciar" class="btn--start">
                  <mat-icon>play_arrow</mat-icon>
                </button>
              }
              <button mat-icon-button (click)="onRestart.emit(p)" matTooltip="Reiniciar">
                <mat-icon>refresh</mat-icon>
              </button>
              <button mat-icon-button (click)="onLogs.emit(p)" matTooltip="Logs">
                <mat-icon>description</mat-icon>
              </button>
              <button mat-icon-button [matMenuTriggerFor]="menu">
                <mat-icon>more_vert</mat-icon>
              </button>
              <mat-menu #menu="matMenu">
                <button mat-menu-item (click)="onReload.emit(p)">
                  <mat-icon>autorenew</mat-icon> Reload
                </button>
                <button mat-menu-item (click)="onDescribe.emit(p)">
                  <mat-icon>info</mat-icon> Detalhes
                </button>
                <button mat-menu-item (click)="onDelete.emit(p)" class="danger-item">
                  <mat-icon>delete</mat-icon> Remover
                </button>
              </mat-menu>
            </div>
          </td>
        </ng-container>

        <tr mat-header-row *matHeaderRowDef="columns"></tr>
        <tr mat-row *matRowDef="let row; columns: columns;" class="proc-row"></tr>
      </table>
    </div>
  `,
  styles: [`
    .table-wrapper {
      background: var(--bg-surface);
      border: 1px solid var(--border-color);
      border-radius: 14px;
      overflow: hidden;
    }

    .proc-table {
      width: 100%;
      background: transparent;
    }

    th.mat-header-cell {
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      border-bottom: 1px solid var(--border-color);
      padding: 12px 16px;
    }

    td.mat-cell {
      font-size: 0.85rem;
      color: var(--text-secondary);
      padding: 10px 16px;
      border-bottom: 1px solid var(--border-color);
    }

    .proc-row:last-child td { border-bottom: none; }

    .proc-row:hover td { background: var(--bg-hover); }

    .cell-id {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.78rem;
      color: var(--text-muted);
    }

    .cell-name {
      font-weight: 600;
      color: var(--text-primary);
    }

    .status-badge {
      font-size: 0.68rem;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 20px;
      letter-spacing: 0.3px;

      &.badge--online  { background: #dcfce7; color: #15803d; }
      &.badge--stopped { background: #f1f5f9; color: #475569; }
      &.badge--errored { background: #fee2e2; color: #dc2626; }
    }

    .row-actions {
      display: flex;
      align-items: center;
      gap: 2px;
    }

    .btn--start { color: #16a34a !important; }
    .btn--stop  { color: #dc2626 !important; }

    ::ng-deep .danger-item { color: #dc2626 !important; }
  `]
})
export class ProcessListComponent {
  @Input() processes: Pm2Process[] = [];
  @Output() onStart    = new EventEmitter<Pm2Process>();
  @Output() onStop     = new EventEmitter<Pm2Process>();
  @Output() onRestart  = new EventEmitter<Pm2Process>();
  @Output() onReload   = new EventEmitter<Pm2Process>();
  @Output() onDelete   = new EventEmitter<Pm2Process>();
  @Output() onLogs     = new EventEmitter<Pm2Process>();
  @Output() onDescribe = new EventEmitter<Pm2Process>();

  columns = ['id', 'name', 'status', 'cpu', 'memory', 'restarts', 'uptime', 'mode', 'actions'];

  formatMemory(bytes: number): string {
    if (!bytes) return '0 B';
    if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
    if (bytes < 1073741824) return (bytes / 1048576).toFixed(1) + ' MB';
    return (bytes / 1073741824).toFixed(1) + ' GB';
  }

  formatUptime(ms: number): string {
    if (!ms) return '—';
    const elapsed = Date.now() - ms;
    const s = Math.floor(elapsed / 1000);
    const m = Math.floor(s / 60);
    const h = Math.floor(m / 60);
    const d = Math.floor(h / 24);
    if (d > 0) return `${d}d ${h % 24}h`;
    if (h > 0) return `${h}h ${m % 60}m`;
    if (m > 0) return `${m}m`;
    return `${s}s`;
  }
}
