.servers-page {
  padding: 24px 0 60px 0;
  width: 95%;
  max-width: 95%;
  margin: 0 auto;
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24px;
  gap: 16px;
  flex-wrap: wrap;
}

.title-with-badge {
  display: flex;
  align-items: center;
  gap: 16px;
}

.page-icon-badge {
  width: 48px;
  height: 48px;
  border-radius: 14px;
  background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 14px rgba(79, 70, 229, 0.35);

  mat-icon {
    font-size: 26px;
    width: 26px;
    height: 26px;
  }
}

.page-title {
  margin: 0 0 4px 0;
  font-size: 22px;
  font-weight: 700;
  color: var(--text-primary, #0f172a);
  letter-spacing: -0.02em;
}

.page-subtitle {
  margin: 0;
  font-size: 13px;
  color: var(--text-muted, #64748b);
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  height: 40px;
  padding: 0 16px;
  border-radius: 10px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  border: 1px solid transparent;

  mat-icon {
    font-size: 18px;
    width: 18px;
    height: 18px;
  }

  &.btn-primary {
    background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%);
    color: #ffffff;
    box-shadow: 0 2px 8px rgba(79, 70, 229, 0.3);

    &:hover:not(:disabled) {
      background: linear-gradient(135deg, #4338ca 0%, #3730a3 100%);
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(79, 70, 229, 0.4);
    }
  }

  &.btn-secondary {
    background: var(--bg-surface, #ffffff);
    color: var(--text-secondary, #334155);
    border-color: var(--border-color, #e2e8f0);

    &:hover:not(:disabled) {
      background: var(--bg-hover, #f1f5f9);
      color: var(--text-primary, #0f172a);
    }
  }

  &.btn-danger {
    background: #ef4444;
    color: #ffffff;

    &:hover:not(:disabled) {
      background: #dc2626;
    }
  }

  &:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
}

/* Grid de Servidores */
.servers-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
  gap: 20px;
}

.server-card {
  background: #ffffff;
  border: 1px solid var(--border-color);
  border-radius: 16px;
  padding: 22px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-shadow: var(--shadow-card);
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;

  &:hover {
    border-color: rgba(99, 102, 241, 0.35);
    transform: translateY(-2px);
    box-shadow: var(--shadow-card-hover);
  }

  &.syncing {
    border-color: #818cf8;
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.12);
  }
}

.card-header-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14px;
}

.server-icon-wrap {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  background: #f1f5f9;
  color: #475569;
  display: flex;
  align-items: center;
  justify-content: center;

  &.success {
    background: #ecfdf5;
    color: #059669;
  }

  &.error {
    background: #fef2f2;
    color: #dc2626;
  }

  mat-icon {
    font-size: 22px;
    width: 22px;
    height: 22px;
  }
}

.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 4px 10px;
  border-radius: 20px;
  font-size: 11px;
  font-weight: 600;

  mat-icon {
    font-size: 14px;
    width: 14px;
    height: 14px;
  }

  &.success {
    background: #dcfce7;
    color: #15803d;
  }

  &.syncing {
    background: #e0e7ff;
    color: #4338ca;
  }

  &.error {
    background: #fee2e2;
    color: #b91c1c;
    cursor: help;
  }

  &.idle {
    background: #f1f5f9;
    color: #64748b;
  }
}

.spinner-small {
  width: 12px;
  height: 12px;
  border: 2px solid #6366f1;
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.server-title {
  margin: 0 0 10px 0;
  font-size: 16px;
  font-weight: 700;
  color: var(--text-primary, #0f172a);
}

.info-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 6px;
  font-size: 13px;
  color: var(--text-secondary, #334155);

  .row-icon {
    font-size: 16px;
    width: 16px;
    height: 16px;
    color: #94a3b8;
  }

  .mono {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
  }

  .color-indigo {
    color: #6366f1;
  }

  &.muted {
    color: var(--text-muted, #64748b);
    font-size: 12px;
  }
}

.error-box {
  margin-top: 10px;
  padding: 8px 12px;
  background: #fef2f2;
  border: 1px solid #fecaca;
  border-radius: 8px;
  color: #b91c1c;
  font-size: 12px;
  display: flex;
  align-items: center;
  gap: 6px;

  mat-icon {
    font-size: 16px;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }
}

.card-actions-footer {
  margin-top: 18px;
  padding-top: 14px;
  border-top: 1px solid var(--border-color, #e2e8f0);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.action-btn.sync-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  height: 32px;
  padding: 0 12px;
  border-radius: 8px;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  color: #334155;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;

  mat-icon {
    font-size: 15px;
    width: 15px;
    height: 15px;
  }

  &:hover:not(:disabled) {
    background: #eef2ff;
    border-color: #c7d2fe;
    color: #4f46e5;
  }

  &:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
}

.right-actions {
  display: flex;
  align-items: center;
  gap: 4px;
}

.icon-btn {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  border: none;
  background: transparent;
  color: #64748b;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s ease;

  mat-icon {
    font-size: 18px;
    width: 18px;
    height: 18px;
  }

  &.edit-btn:hover {
    background: #f1f5f9;
    color: #4f46e5;
  }

  &.delete-btn:hover {
    background: #fee2e2;
    color: #ef4444;
  }
}

.spin {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* Empty State */
.empty-state {
  grid-column: 1 / -1;
  text-align: center;
  padding: 60px 20px;
  background: var(--bg-surface, #ffffff);
  border: 1px dashed var(--border-color, #cbd5e1);
  border-radius: 16px;

  .empty-icon {
    width: 64px;
    height: 64px;
    border-radius: 20px;
    background: #f1f5f9;
    color: #64748b;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;

    mat-icon {
      font-size: 32px;
      width: 32px;
      height: 32px;
    }
  }

  h3 {
    font-size: 18px;
    font-weight: 700;
    color: var(--text-primary, #0f172a);
    margin: 0 0 6px 0;
  }

  p {
    font-size: 13px;
    color: var(--text-muted, #64748b);
    margin: 0 0 20px 0;
  }
}

/* Modal CSS (Em conformidade com o Angular Modal Layout Skill) */
.modal-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background-color: rgba(15, 23, 42, 0.6);
  backdrop-filter: blur(4px);
  z-index: 1050;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
}

.modal-wrapper {
  display: flex;
  flex-direction: column;
  max-height: 90vh;
  width: 100%;
  background: var(--bg-surface, #ffffff);
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2), 0 0 0 1px rgba(226, 232, 240, 0.8);

  &.max-w-xl { max-width: 580px; }
  &.max-w-2xl { max-width: 680px; }
  &.max-w-md { max-width: 440px; }
}

.modal-header {
  flex-shrink: 0;
  position: sticky;
  top: 0;
  z-index: 10;
  padding: 18px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--border-color, #f1f5f9);
  background: linear-gradient(135deg, rgba(79, 70, 229, 0.05) 0%, #ffffff 100%);
}

.header-main {
  display: flex;
  align-items: center;
  gap: 14px;
}

.header-icon-badge {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 10px rgba(79, 70, 229, 0.25);

  &.edit-mode {
    background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
  }

  &.danger {
    background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%);
    box-shadow: 0 4px 10px rgba(239, 68, 68, 0.25);
  }

  .material-icons {
    font-size: 20px;
  }
}

.header-title-box h2 {
  margin: 0 0 2px 0;
  font-size: 17px;
  font-weight: 700;
  color: #0f172a;
}

.header-title-box p {
  margin: 0;
  font-size: 12px;
  color: #64748b;
}

.close-btn {
  background: #f1f5f9;
  border: none;
  width: 32px;
  height: 32px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: #64748b;
  transition: all 0.2s ease;

  .material-icons {
    font-size: 18px;
  }

  &:hover {
    background: #fee2e2;
    color: #ef4444;
    transform: rotate(90deg);
  }
}

.modal-body {
  flex: 1;
  padding: 20px 24px;
  overflow-y: auto;
  max-height: calc(90vh - 130px);
}

.modal-footer {
  flex-shrink: 0;
  position: sticky;
  bottom: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10px;
  padding: 14px 24px;
  background: #ffffff;
  border-top: 1px solid #e2e8f0;
}

/* Form Groups (Em conformidade com o Angular Form Groups Skill) */
.form-container {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.form-card {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  padding: 16px 18px;
}

.card-header {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 14px;
  padding-bottom: 8px;
  border-bottom: 1px solid #f1f5f9;

  h3 {
    margin: 0;
    font-size: 14px;
    font-weight: 700;
    color: #1e293b;
  }

  .section-icon {
    font-size: 18px;
    width: 18px;
    height: 18px;
  }
}

.color-blue { color: #4f46e5; }
.color-emerald { color: #10b981; }

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14px;
}

.col-span-2 {
  grid-column: span 2;
}

.form-field {
  display: flex;
  flex-direction: column;
  gap: 5px;

  label {
    font-size: 12px;
    font-weight: 600;
    color: #475569;
  }

  .required {
    color: #ef4444;
  }

  input {
    height: 38px;
    padding: 0 12px;
    border: 1.5px solid #cbd5e1;
    border-radius: 8px;
    font-size: 13px;
    color: #1e293b;
    outline: none;
    transition: all 0.2s ease;

    &:focus {
      border-color: #4f46e5;
      box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.12);
    }
  }

  .helper-text {
    font-size: 11px;
    color: #64748b;

    code {
      background: #f1f5f9;
      padding: 1px 4px;
      border-radius: 4px;
      color: #4f46e5;
    }
  }
}

/* Help Content */
.help-content {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.step-card {
  display: flex;
  gap: 14px;
  padding: 14px;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 10px;

  .step-badge {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #4f46e5;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 13px;
    flex-shrink: 0;
  }

  .step-text {
    flex: 1;

    h4 {
      margin: 0 0 4px 0;
      font-size: 13px;
      font-weight: 700;
      color: #0f172a;
    }

    p {
      margin: 0 0 6px 0;
      font-size: 12px;
      color: #475569;
    }

    pre {
      margin: 0;
      padding: 8px 10px;
      background: #0f172a;
      color: #e2e8f0;
      border-radius: 6px;
      font-size: 12px;
      font-family: 'JetBrains Mono', monospace;
      overflow-x: auto;
    }
  }
}

.delete-warning-text {
  font-size: 14px;
  color: #0f172a;
  margin: 0 0 8px 0;
}

.delete-warning-sub {
  font-size: 12px;
  color: #ef4444;
  margin: 0;
}

.button-spinner {
  display: inline-block;
  margin-right: 6px;
}

